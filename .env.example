# TraceHold settings. Copy this file to `.env` and fill it in. Never put real keys in this file.

# FalkorDB (started by deploy/ec2.sh, or on its own with: bash deploy/falkordb.sh start)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Where the data pipeline writes generated data: the cleaned table, reports and the graph snapshot (about 1 GB).
# Relative to the TraceHold folder, or an absolute path. On a Linux server the deploy scripts use ~/tracehold-work.
TRACEHOLD_WORK_DIR=work

# IBM's three files are found through synthetic/overlay_config.yaml (input: ...), not here.

# ---- The model (agents/config.yaml, model.id) ----
# Default: Claude Opus 4.6 on Amazon Bedrock (bedrock/claude-opus-4-6). Create a long-term Bedrock API key in the
# AWS console, region US East (Ohio): Bedrock > API keys. Never commit this file.
BEDROCK_API_KEY=


# ---- Tracing (needed by the sandbox setup, deploy/sandboxes.sh; Langfuse Cloud project > Settings > API keys) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Where the agents find the tool server, and which bank they work for (defaults shown) ----
# TRACEHOLD_TOOL_SERVER_URL=http://127.0.0.1:8000
# TRACEHOLD_BANK_ID=11
